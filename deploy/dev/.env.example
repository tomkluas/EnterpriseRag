# Development only. Init generates independent secrets. Never commit .env.
V3_MODE=development
V3_TENANT_ID=enterprise
V3_BOOTSTRAP_USER=admin
V3_BOOTSTRAP_TOKEN=__BOOTSTRAP_TOKEN__
V3_POSTGRES_PASSWORD=__DATABASE_PASSWORD__
V3_DATABASE_URL=postgresql+psycopg2://v3:__DATABASE_PASSWORD__@database:5432/enterpriserag_v3
V3_OBJECTS_DIR=/data/objects
V3_MODEL_BASE_URL=
V3_CHAT_MODEL=
V3_MODEL_KEY_REF=V3_SECRET_MODEL
V3_SECRET_MODEL=
V3_RERANK_MODEL=
V3_RERANK_BASE_URL=
V3_RERANK_KEY_REF=V3_SECRET_RERANK
V3_SECRET_RERANK=
V3_EMBEDDING_BASE_URL=
V3_EMBEDDING_MODEL=
V3_EMBEDDING_DIMENSION=1024
V3_SECRET_EMBEDDING=
# Only for trusted internal model hosts, e.g. host.docker.internal. Do not allow all IPs.
WK_MODEL_HOST_ALLOWLIST=
V3_SECRET_WK_READ=
V3_SECRET_WK_WRITE=
V3_SECRET_WK_MANAGE=
WK_DATABASE_PASSWORD=__WK_DATABASE_PASSWORD__
WK_JWT_SECRET=__WK_JWT_SECRET__
WK_AES_KEY=__WK_AES_KEY__
WK_SIGNING_KEY=__WK_SIGNING_KEY__
WK_ADMIN_EMAIL=v3-dev@example.invalid
WK_ADMIN_PASSWORD=__WK_ADMIN_PASSWORD__
