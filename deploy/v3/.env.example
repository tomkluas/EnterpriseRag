# Copy to deploy/v3/.env. Never copy old V1/V2 runtime secrets.
V3_MODE=production
V3_TENANT_ID=enterprise
V3_POSTGRES_PASSWORD=replace_with_random_password
V3_DATABASE_URL=postgresql+psycopg2://v3:replace_with_random_password@database:5432/enterpriserag_v3
V3_BOOTSTRAP_USER=admin
V3_OIDC_ISSUER=https://identity.company.example
V3_OIDC_AUDIENCE=enterpriserag-v3
V3_OIDC_JWKS_URL=https://identity.company.example/.well-known/jwks.json
# Signed JWT includes tenant_id and sub; provision member sub in V3.
V3_OBJECTS_URI=s3://enterpriserag-v3/originals
V3_S3_ENDPOINT=https://objects.company.example
V3_S3_REGION=us-east-1
V3_SECRET_S3_ACCESS=
V3_SECRET_S3_SECRET=
V3_MODEL_BASE_URL=https://models.company.example/v1
V3_CHAT_MODEL=
V3_RERANK_MODEL=
V3_SECRET_MODEL=
V3_SECRET_WK_READ=
V3_SECRET_WK_WRITE=
V3_SECRET_WK_MANAGE=
V3_SECRET_DIFY_READ=
V3_SECRET_DIFY_WRITE=
V3_SECRET_DIFY_MANAGE=
# Optional alert receiver; blank disables outbound delivery. Receiver deduplicates event_id.
V3_ALERT_WEBHOOK_URL=
